# =============================================================================
# HillDesk environment reference
# =============================================================================
# Every variable the code reads, grouped by when you need it. Development needs
# NONE of these: `python manage.py bootstrap_demo` runs on built-in defaults
# (SQLite, mock AI provider, local sign-in).
#
# In production, inject values from a secrets manager. Never commit a real
# .env file. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

# -----------------------------------------------------------------------------
# REQUIRED in production (the app refuses to start without the first three)
# -----------------------------------------------------------------------------
SECRET_KEY=
FIELD_ENCRYPTION_KEY=            # encrypts PII fields; losing it loses that data
CONTACT_BLIND_INDEX_KEY=         # HMAC key for exact-match lookups; falls back to FIELD_ENCRYPTION_KEY
ALLOWED_HOSTS=hilldesk.example.com
CSRF_TRUSTED_ORIGINS=https://hilldesk.example.com
CORS_ALLOWED_ORIGINS=https://hilldesk.example.com

# PostgreSQL (TLS is required)
DB_NAME=hilldesk
DB_USER=hilldesk_app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSL_ROOT_CERT=                # path to the RDS CA bundle
DB_SSL_CERT=                     # optional client cert
DB_SSL_KEY=                      # optional client key

# Redis (Celery broker + cache)
REDIS_URL=rediss://your-redis-host:6379/0

# Azure AD / Entra ID sign-in (OIDC)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Microsoft Graph (mail + calendar; see docs/graph-setup.md)
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
SCHEDULING_MAILBOXES=scheduling@your-office.example.com   # comma-separated shared mailboxes
INTERNAL_EMAIL_DOMAINS=your-office.example.com            # comma-separated; seeds the sender allowlist

# Amazon Bedrock (production allows no other provider)
LLM_PROVIDER=bedrock
AWS_REGION=us-gov-west-1
BEDROCK_EXTRACTION_MODEL=anthropic.claude-3-sonnet-20240229-v1:0   # use a model enabled in your account
BEDROCK_KB_ID=                   # optional Bedrock knowledge base

# -----------------------------------------------------------------------------
# OPTIONAL: ingestion tuning (defaults shown)
# -----------------------------------------------------------------------------
INGEST_SWEEP_MINUTES=5
GRAPH_WEBHOOK_ENABLED=False      # sweeps always run; webhooks only add speed
GRAPH_WEBHOOK_NOTIFICATION_URL=
GRAPH_WEBHOOK_CLIENT_STATE=      # random secret echoed by Graph notifications
RATE_GATE_SENDER_LIMIT=20
RATE_GATE_MAILBOX_LIMIT=200
RATE_GATE_WINDOW_MINUTES=60
DEDUP_WINDOW_DAYS=14
RESCORE_WINDOW_DAYS=30
SERIES_HORIZON_DAYS=400
CANDIDATE_CAP=10
DIGEST_TOKEN_THRESHOLD=12
LLM_MIN_CONFIDENCE=0.7
ATTACHMENT_STORE_MAX_BYTES=10485760
ENABLE_CALENDAR_SYNC=True

# -----------------------------------------------------------------------------
# OPTIONAL: operations
# -----------------------------------------------------------------------------
SECURITY_EMAIL=security@your-office.example.com   # receives Django error mail
ADMIN_EMAIL=admin@your-office.example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
MFA_ISSUER_NAME=HillDesk
INTERNAL_IPS=
SECURE_HSTS_SECONDS=31536000
BACKUP_ENCRYPTION_KEY=
LOG_DIR=                         # empty = JSON logs to stdout (containers); set a path for rotating files

# Static files from S3 instead of the container (requires django-storages)
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# Prefer an IAM task role over static keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY (ignored or refused in production)
# -----------------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.development
# LLM_PROVIDER=mock               # or anthropic_dev for API testing
# ANTHROPIC_API_KEY=              # only with LLM_PROVIDER=anthropic_dev
# USE_SSO=False
# DJANGO_DEV_USERNAME=dev         # python manage.py create_dev_user
# DJANGO_DEV_PASSWORD=
# DEMO_DB_DIR=                    # where the dev SQLite file lives
